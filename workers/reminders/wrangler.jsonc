{
  "name": "stride-reminder-scheduler",
  "main": "index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "secrets": {
    "required": [
      "STRIDE_ORIGIN",
      "REMINDER_DISPATCH_SECRET",
      "SITES_ACCESS_TOKEN",
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
